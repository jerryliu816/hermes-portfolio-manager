# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
# Host port is 5433, NOT the default 5432, so this project can run alongside
# another local Postgres. The container-internal port is still 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-locally

# --- extraction provider ----------------------------------------------------
# mock  = deterministic, no network, no cost. Used by the whole test suite.
# anthropic = real Claude extraction. Requires ANTHROPIC_API_KEY.
EXTRACTION_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=600
EXTRACTION_EFFORT=high
MAX_EXTRACTION_ATTEMPTS=2
EXTRACTION_ACCOUNTS_PER_CALL=5
EXTRACTION_MAX_PAGES=600
EXTRACTION_MAX_BYTES=33554432
# WARNING: logs full document and model content, including holdings. Sensitive.
EXTRACTION_DEBUG_LOG=false

# --- reconciliation tolerances ----------------------------------------------
# A check passes if EITHER the absolute or the percentage tolerance is met,
# but the effective tolerance is capped so a percentage cannot grant unlimited
# slack on a large account.
RECON_ABS_TOLERANCE=1.00
RECON_PCT_TOLERANCE=0.001
RECON_MAX_ABS_TOLERANCE=25.00

# --- snapshots --------------------------------------------------------------
SNAPSHOT_DATE_TOLERANCE_DAYS=5
AUTO_APPROVE_CLEAN_IMPORTS=false

# --- storage ----------------------------------------------------------------
DATA_DIR=data

# --- hermes (optional; app is fully usable with this off) -------------------
HERMES_ENABLED=false
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
HERMES_TIMEOUT_SECONDS=5
# The Advisor page chats through Hermes's api_server platform. The key must
# match API_SERVER_KEY on the Hermes side; it never reaches the browser.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# --- api --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8787

# ---------------------------------------------------------------------------
# Deployment notes
#
# `docker compose up -d` runs Postgres and the app together. The app container
# applies migrations on start, so there is no separate step to forget.
#
# Two volumes matter and they matter equally:
#   portfolio-pgdata   the database
#   portfolio-sources  the original documents, at /app/data
#
# The documents are the only way to re-derive a reading if the schema changes or
# an extraction provider improves, so back them up together:
#
#   docker compose run --rm app backup create /backups
#   docker compose run --rm app backup inspect /backups/<archive>
#   docker compose run --rm app backup restore /backups/<archive> --yes
#
# `./backups` on the host is mounted at /backups in the container.
# ---------------------------------------------------------------------------
